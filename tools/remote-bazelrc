# Remote execution settings shared by Google RBE and BuildBuddy.
common:remote_shared --jobs=200
common:remote_shared --disk_cache=
common:remote_shared --remote_download_minimal
common:remote_shared --define=EXECUTOR=remote
common:remote_shared --remote_timeout=3600

# Select after the remote profile to download requested output artifacts.
common:remote_toplevel --remote_download_outputs=toplevel

# Preserve the Google execution and cache-only profiles.
common:remote --config=remote_shared
common:remote --config=remote-cache
common:remote --extra_execution_platforms=//tools/remote:platform
common:remote --host_platform=//tools/remote:platform
common:remote --platforms=//tools/remote:platform
common:remote --remote_executor=remotebuildexecution.googleapis.com
common:remote-cache --remote_cache=remotebuildexecution.googleapis.com
common:remote-cache --remote_timeout=3600
common:remote-cache --google_default_credentials

# Also available without BuildBuddy via --config=diagnostics.
# Override both paths for concurrent invocations.
common:diagnostics --execution_log_compact_file=bazel-execution.log
common:diagnostics --profile=bazel-profile.json.gz
common:diagnostics --experimental_profile_include_target_label
common:diagnostics --experimental_profile_include_primary_output
common:diagnostics --noslim_profile

# Reporting only: preserve local execution, platforms and disk cache.
build:reporting_bb --bes_results_url=https://app.buildbuddy.io/invocation/
build:reporting_bb --bes_backend=grpcs://remote.buildbuddy.io
common:reporting_bb --config=diagnostics

# These commands inherit build options but should not publish invocations.
run:reporting_bb --bes_backend=
run:reporting_bb --bes_results_url=
aquery:reporting_bb --bes_backend=
aquery:reporting_bb --bes_results_url=
cquery:reporting_bb --bes_backend=
cquery:reporting_bb --bes_results_url=
# Plain query does not inherit build-scoped BES options.

# Cache misses still execute locally; neither Google auth nor a remote platform
# is selected. Compression and chunking reduce large-blob transfer costs.
common:cache_bb --config=reporting_bb
common:cache_bb --remote_cache=grpcs://remote.buildbuddy.io
common:cache_bb --remote_upload_local_results
common:cache_bb --remote_cache_compression
common:cache_bb --experimental_remote_cache_chunking

# Remote execution includes reporting and caching, without Google credentials.
common:remote_bb --config=remote_shared
common:remote_bb --config=cache_bb
# Permission-sensitive repository tests must not execute as root.
common:remote_bb --extra_execution_platforms=//tools/remote:buildbuddy_platform
common:remote_bb --host_platform=//tools/remote:buildbuddy_platform
common:remote_bb --platforms=//tools/remote:buildbuddy_platform
common:remote_bb --remote_executor=grpcs://remote.buildbuddy.io
