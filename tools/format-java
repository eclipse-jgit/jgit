set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
repo_root="$(cd -- "$script_dir/.." >/dev/null 2>&1 && pwd)"

exec bazelisk run //tools/formatter:formatter -- \
	--profile "$repo_root/tools/eclipse-JGit-Format.xml" "$@"
