      "writtenOn": "2026-10-02T11:58:15Z",
      "side": 1,
      "message": "Out of curiosity, how many elements can this `queue` typically have? Can this (even with the short-circuit logic of the streams) become a performance issue?",
      "range": {
        "startLine": 81,
        "startChar": 0,
        "endLine": 81,
        "endChar": 2
      },
      "revId": "659a1e5ea3137ec0e3d5ceec8f1b216add124145",
